# --- Neon -------------------------------------------------------------------
# Project region MUST be aws ap-southeast-1 (Singapore) to sit next to the
# Vercel functions in sin1. Use the POOLED connection string (-pooler host).
# Injected automatically on Vercel by the Neon integration, including a fresh
# copy-on-write branch for every preview deployment.
NUXT_DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/bibo?sslmode=require"

# --- Admin ------------------------------------------------------------------
# Phase 0 only: a shared bearer token gates the presigned-upload route.
# Parent sessions now exist separately; this token still gates recording upload.
NUXT_ADMIN_TOKEN="change-me"

# --- Parent auth -------------------------------------------------------------
# Server-only pepper added before scrypt hashing. Set this once per environment
# and keep it stable, or existing passwords will no longer verify.
NUXT_AUTH_PEPPER="replace-with-a-long-random-secret"

# --- Cloudflare R2 ----------------------------------------------------------
# Audio and artwork. Never Vercel Blob: R2 egress is $0, and a 48kHz WAV master
# exceeds Vercel's hard 4.5MB function body limit, so uploads go direct to R2.
NUXT_R2_ACCOUNT_ID=""
NUXT_R2_BUCKET="bibo-media"
NUXT_R2_ACCESS_KEY_ID=""
NUXT_R2_SECRET_ACCESS_KEY=""

# Public read base (custom domain in front of the R2 bucket).
NUXT_PUBLIC_MEDIA_BASE="https://media.bibowika.ph"

# --- Development ------------------------------------------------------------
# Placeholder speech synthesis so exercise flows can be built before the studio
# recordings land. There is no real TTS for ceb/ilo/hil, so this MUST stay
# false in any build a child will touch. See spec section 08.
NUXT_PUBLIC_DEV_TTS="true"
